# ------------------------------------------------------------------
# NextRide — environment reference
# The docker-compose file (deploy/docker-compose.yml) works out of the box
# with sensible defaults. These variables are overridable per environment.
# ------------------------------------------------------------------

# ---- Public endpoints (host side) ----
# Port exposed for the backend API (inside the container it is always 5000)
BACKEND_PORT=5002
# Port exposed for the ML service
ML_PORT=5001
# Port exposed for the frontend
FRONTEND_PORT=3000
# Base URL the browser uses to reach the API (baked into the frontend build)
REACT_APP_API_URL=http://localhost:5002

# ---- Cassandra ----
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=cars_keyspace
CASSANDRA_LOCAL_DATACENTER=datacenter1

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- Backend ----
# Secret used to sign JWTs (change in production!)
JWT_SECRET=nextride-dev-secret-change-me

# ---- Seeding ----
NUM_USERS=10
MAX_USERS=5
